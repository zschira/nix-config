{
  description = "Zach's NixOS configurations";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    nixpkgs-unstable.url = "github:NixOS/nixpkgs/nixos-unstable";
    home-manager = {
      url = "github:nix-community/home-manager/release-26.05";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    git-hooks = {
      url = "github:cachix/git-hooks.nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      nixpkgs-unstable,
      home-manager,
      git-hooks,
      ...
    }@inputs:
    let
      system = "x86_64-linux";
      pkgs-unstable = import nixpkgs-unstable {
        inherit system;
        config.allowUnfree = true;
      };
      mkHost =
        configuration:
        nixpkgs.lib.nixosSystem {
          inherit system;
          specialArgs = { inherit inputs pkgs-unstable; };
          modules = [
            home-manager.nixosModules.home-manager
            configuration
          ];
        };
      pkgs = nixpkgs.legacyPackages.${system};

      pre-commit-check = git-hooks.lib.${system}.run {
        src = ./.;
        # Generated by nixos-generate-config; not meant to be edited
        excludes = [ "hardware-configuration\\.nix$" ];
        hooks = {
          # Nix
          nixfmt.enable = true;
          statix = {
            enable = true;
            settings = {
              config = "statix.toml";
              ignore = [ "*hardware-configuration.nix" ];
            };
          };
          deadnix = {
            enable = true;
            settings = {
              # Module args like `{ config, pkgs, ... }:` are conventional
              noLambdaPatternNames = true;
              exclude = [
                "desktop-hardware-configuration.nix"
                "laptop-hardware-configuration.nix"
              ];
            };
          };

          # Hygiene
          trim-trailing-whitespace.enable = true;
          end-of-file-fixer.enable = true;
          check-merge-conflicts.enable = true;
          check-added-large-files.enable = true;

          # Secrets
          detect-private-keys.enable = true;
          trufflehog.enable = true;

          # Slow; only run on push
          flake-check = {
            enable = true;
            name = "nix flake check";
            entry = "nix flake check";
            language = "system";
            pass_filenames = false;
            always_run = true;
            stages = [ "pre-push" ];
          };
        };
      };
    in
    {
      checks.${system}.pre-commit = pre-commit-check;

      devShells.${system}.default = pkgs.mkShell {
        # Installs the git hooks on entry
        inherit (pre-commit-check) shellHook;
        packages = pre-commit-check.enabledPackages;
      };

      # Hostnames match the output names, so `nixos-rebuild switch --flake .`
      # picks the right configuration automatically.
      nixosConfigurations = {
        zach-desktop = mkHost ./desktop-configuration.nix;
        zach-laptop = mkHost ./laptop-configuration.nix;
      };
    };
}
